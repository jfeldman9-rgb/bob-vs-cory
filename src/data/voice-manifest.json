 {
  "id": "narr_intro_01",
  "speaker": "announcer",
  "file": "narr_intro_01.mp3",
  "trigger": "story intro still 01",
  "text": "In a city that never sleeps, two legends refuse to share the spotlight.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_intro_02",
  "speaker": "announcer",
  "file": "narr_intro_02.mp3",
  "trigger": "story intro still 02",
  "text": "Agent Bob. Precision. Protocol. Zero tolerance for anomalies.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_intro_03",
  "speaker": "announcer",
  "file": "narr_intro_03.mp3",
  "trigger": "story intro still 03",
  "text": "Flamboyant Cory. Sequins. Spectacle. Zero tolerance for boring.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_intro_04",
  "speaker": "announcer",
  "file": "narr_intro_04.mp3",
  "trigger": "story intro still 04",
  "text": "The Golden Aubergine tournament has summoned them both.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_intro_05",
  "speaker": "announcer",
  "file": "narr_intro_05.mp3",
  "trigger": "story intro still 05",
  "text": "Only one will walk out holding the Golden Aubergine.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_ch1",
  "speaker": "announcer",
  "file": "narr_ch1.mp3",
  "trigger": "story chapter 1 card",
  "text": "Chapter one. Sector Seven. Down here, the rain never stops.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_ch2",
  "speaker": "announcer",
  "file": "narr_ch2.mp3",
  "trigger": "story chapter 2 card",
  "text": "Chapter two. Forty floors up, the party never stops either.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_ch3",
  "speaker": "announcer",
  "file": "narr_ch3.mp3",
  "trigger": "story chapter 3 card",
  "text": "Chapter three. The Colosseum of the Golden Aubergine.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_ch4",
  "speaker": "announcer",
  "file": "narr_ch4.mp3",
  "trigger": "story chapter 4 card",
  "text": "Final chapter. A desert lounge at midnight. One last dance.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_rival_bob",
  "speaker": "announcer",
  "file": "narr_rival_bob.mp3",
  "trigger": "arcade rival still (bob)",
  "text": "One rival remains. He is wearing feathers.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_rival_cory",
  "speaker": "announcer",
  "file": "narr_rival_cory.mp3",
  "trigger": "arcade rival still (cory)",
  "text": "One rival remains. He is wearing a suit. Of course he is.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_bob_end_01",
  "speaker": "announcer",
  "file": "narr_bob_end_01.mp3",
  "trigger": "bob ending still 01",
  "text": "Agent Bob claims the Golden Aubergine. The anomaly is contained.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_bob_end_02",
  "speaker": "announcer",
  "file": "narr_bob_end_02.mp3",
  "trigger": "bob ending still 02",
  "text": "His report is flawless, except for one pink sequin he cannot explain.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_bob_end_03",
  "speaker": "announcer",
  "file": "narr_bob_end_03.mp3",
  "trigger": "bob ending still 03",
  "text": "Later, the System logs an irregularity. Agent Bob is tapping his boot.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_cory_end_01",
  "speaker": "announcer",
  "file": "narr_cory_end_01.mp3",
  "trigger": "cory ending still 01",
  "text": "Flamboyant Cory wins the Golden Aubergine, and the crowd goes wild.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_cory_end_02",
  "speaker": "announcer",
  "file": "narr_cory_end_02.mp3",
  "trigger": "cory ending still 02",
  "text": "By sunrise, the ancient colosseum is the hottest club in the realm.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_cory_end_04",
  "speaker": "announcer",
  "file": "narr_cory_end_04.mp3",
  "trigger": "cory ending still 04",
  "text": "And somewhere deep in the System, an agent learns to dance.",
  "source": "elevenlabs:eleven_v4:jason-clone"
 },
 {
  "id": "narr_credits",
  "speaker": "announcer",
  "file": "narr_credits.mp3",
